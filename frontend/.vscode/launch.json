{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API",
      "runtimeExecutable": "nodemon",
      "runtimeArgs": [
        "--inspect",
        "--legacy-watch"    // optional, helps with Windows file watching
      ],
      "program": "${workspaceFolder}/api.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
